# Figma Personal Access Token.
# Genera uno en: https://www.figma.com/developers/api#access-tokens
# Scopes recomendados: file_content:read, file_variables:read (Enterprise), file_dev_resources:read
# Acepta el nombre FIGMA_TOKEN o el alias FIGMA_API_KEY.
FIGMA_TOKEN=

# File key del archivo de Figma.
# Se saca de la URL: https://www.figma.com/design/<FILE_KEY>/<nombre>
FIGMA_FILE_KEY=

# (Opcional) Escala del render PNG. Por defecto 2.
# FIGMA_PNG_SCALE=2

# (Opcional) Concurrencia de requests a la API. Por defecto 3.
# FIGMA_CONCURRENCY=3
